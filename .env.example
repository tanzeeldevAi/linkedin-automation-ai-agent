# Copy this file to .env and fill it in.
# .env is gitignored -- never commit real values.

# ── LOCAL RUNS ─────────────────────────────────────────────
# Running on your own machine? You need nothing in here at all.
# The dashboard binds to localhost and skips the password prompt,
# and drafting uses the Claude CLI you are already signed into.

# ── CONTAINER / VPS RUNS ───────────────────────────────────
# Both of these are REQUIRED once the container is exposed. The entrypoint
# refuses to start without them rather than serving an unlocked browser that
# is logged into your LinkedIn account.

# Protects the dashboard (HTTP basic auth).
DASHBOARD_PASSWORD=

# Protects the remote browser view (x11vnc). This is the window you log
# into LinkedIn through, so treat it like your LinkedIn password.
VNC_PASSWORD=

# ── OPTIONAL ───────────────────────────────────────────────
# Comments can run on Groq instead of the Claude CLI. Free tier, no card.
# https://console.groq.com
GROQ_API_KEY=
